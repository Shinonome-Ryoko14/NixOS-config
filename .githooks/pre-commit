#!/bin/sh
# hosts/<name>/hardware-configuration.nix is generated per machine and must not
# be committed. It stays in the index as an intent-to-add entry so that the
# flake source still contains it (Nix ignores untracked files).
#
# When something stages its content (for example `git add -A`), drop the content
# again but keep the intent-to-add marker.
files=$(git diff --cached --name-only --diff-filter=ACMR -- 'hosts/*/hardware-configuration.nix')
if [ -n "$files" ]; then
  printf '%s\n' "$files" | while IFS= read -r f; do
    [ -n "$f" ] || continue
    git reset -q -- "$f"
    git add -N -f -- "$f"
    echo "pre-commit: 已跳过机器本地文件 $f" >&2
  done
fi

exit 0
