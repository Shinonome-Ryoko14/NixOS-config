{ inputs }:
let
  inherit (inputs.nixpkgs.lib) optional optionals;
  system = "x86_64-linux";
in
{
  inherit system;

  # An installed host: shared modules, then hosts/<name> with its profiles.
  # Existing callers can pass a name; other architectures pass { name; system; }.
  mkHost = host:
    let
      spec = if builtins.isString host then { name = host; } else host;
      hostSystem = spec.system or system;
      # Generated by `nixos-generate-config` on the target machine and kept out
      # of git; see hosts/README.md. Import it when it exists so a fresh clone
      # still evaluates, and warn instead of failing on a missing fileSystems.
      hardware = ../hosts/${spec.name}/hardware-configuration.nix;
      hasHardware = builtins.pathExists hardware;
    in
    inputs.nixpkgs.lib.nixosSystem {
      specialArgs = { inherit inputs; system = hostSystem; };
      modules = [
        ../modules/nixos
        ../hosts/${spec.name}
        {
          networking.hostName = spec.name;
          nixpkgs.hostPlatform = inputs.nixpkgs.lib.mkDefault hostSystem;
        }
      ]
      ++ optional hasHardware hardware
      ++ optionals (!hasHardware) [{
        warnings = [
          "hosts/${spec.name}/hardware-configuration.nix 不存在;请先运行 nixos-generate-config 生成,并执行 git add -N -f 让 flake 看到它。"
        ];
      }];
    };
}
